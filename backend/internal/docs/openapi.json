{
  "openapi": "3.0.0",
  "info": { "title": "MockHub · 在线 API Mock 服务", "version": "1.0.0", "description": "MockHub - Go 1.22 + Gin + GORM" },
  "paths": {
    "/api/v1/auth/register": { "post": { "summary": "注册" } },
    "/api/v1/auth/login": { "post": { "summary": "登录" } },
    "/api/v1/auth/me": { "get": { "summary": "当前用户", "security": [{ "bearerAuth": [] }] } },
    "/api/v1/projects": { "get": { "summary": "项目列表" }, "post": { "summary": "创建项目" } },
    "/api/v1/projects/{id}": { "get": { "summary": "项目详情" }, "put": { "summary": "更新项目" }, "delete": { "summary": "删除项目" } },
    "/api/v1/projects/{projectId}/apis": { "get": { "summary": "接口列表" }, "post": { "summary": "新建接口" } },
    "/api/v1/projects/{projectId}/apis/{id}": { "get": { "summary": "接口详情" }, "put": { "summary": "更新接口" }, "delete": { "summary": "删除接口" } },
    "/api/v1/projects/{projectId}/swagger/preview": { "post": { "summary": "预览 OpenAPI 导入（返回新增/重复/无法解析条目，不写入）" } },
    "/api/v1/projects/{projectId}/swagger/commit": { "post": { "summary": "确认导入（仅写入选中条目，返回逐条失败明细）" } },
    "/api/v1/projects/{projectId}/swagger/import": { "post": { "summary": "一键导入 OpenAPI（旧接口，新增条目并跳过重复，推荐使用 preview + commit）" } },
    "/api/v1/projects/{projectId}/logs": { "get": { "summary": "请求日志" }, "delete": { "summary": "清空日志" } },
    "/mock/{projectId}/{path}": { "get": { "summary": "Mock 引擎" }, "post": { "summary": "Mock 引擎" } },
    "/healthz": { "get": { "summary": "健康检查" } }
  },
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } } }
}
